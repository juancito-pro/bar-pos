# Copia este archivo como ".env" y coloca los datos de tu proyecto Supabase
# (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-o-publishable-key

# Dominio usado para convertir "usuario" en correo interno (usuario@bar.app)
VITE_EMAIL_DOMAIN=bar.app
